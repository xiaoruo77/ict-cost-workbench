  "rules": [
    {
      "id": "materials",
      "op": "recognize",
      "source": "materials_used",
      "posting_pool": "production"
    },
    {
      "id": "paid_wages",
      "op": "recognize",
      "source": "wages_paid_cost",
      "posting_pool": "production"
    },
    {
      "id": "accrued_wages",
      "op": "recognize",
      "source": "wages_accrued_cost",
      "posting_pool": "production"
    },
    {
      "id": "wages",
      "op": "sum",
      "inputs": [
        "paid_wages",
        "accrued_wages"
      ]
    },
    {
      "id": "depreciation",
      "op": "monthly_straight_line",
      "source": "machine_basis",
      "start": "2026-01",
      "months": 12,
      "posting_pool": "production"
    },
    {
      "id": "rent_expense",
      "op": "monthly_straight_line",
      "source": "factory_rent_basis",
      "start": "2026-01",
      "months": 12,
      "posting_pool": "production"
    },
    {
      "id": "production_cost",
      "op": "sum",
      "inputs": [
        "materials",
        "wages",
        "depreciation",
        "rent_expense"
      ]
    },
    {
      "id": "completed_goods_cost",
      "op": "inventory_bridge",
      "flow": "production_cost",
      "opening": "wip_open",
      "closing": "wip_close"
    },
    {
      "id": "cost_of_sales",
      "op": "inventory_bridge",
      "flow": "completed_goods_cost",
      "opening": "fg_open",
      "closing": "fg_close"
    },
    {
      "id": "administration",
      "op": "recognize",
      "source": "administration_cost",
      "posting_pool": "period"
    },
    {
      "id": "admin_credit",
      "op": "recognize",
      "source": "administration_credit",
      "posting_pool": "period"
    },
    {
      "id": "period_cost",
      "op": "sum",
      "inputs": [
        "administration",
        "admin_credit"
      ]
    },
    {
      "id": "pnl_cost",
      "op": "sum",
      "inputs": [
        "cost_of_sales",
        "period_cost"
      ]
    }
  ],
  "outputs": [
